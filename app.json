{
  "expo": {
    "name": "Ivoire Style",
    "slug": "ivoire-style",
    "version": "1.0.0",
    "scheme": "ivoirestyle",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ci.ivoirestyle.app"
    },
    "android": {
      "package": "ci.ivoirestyle.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      "@react-native-vector-icons/fontawesome6",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ivoire Style a besoin d'accéder à vos photos pour votre photo de profil et le logo de votre boutique.",
          "cameraPermission": "Ivoire Style a besoin de l'appareil photo pour prendre votre photo de profil."
        }
      ]
    ]
  }
}
